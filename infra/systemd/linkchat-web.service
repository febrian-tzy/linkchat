# ─── systemd Service: LinkChat Next.js Frontend ──────────────────────────────
# Place this file at: /etc/systemd/system/linkchat-web.service
# Commands:
#   sudo systemctl daemon-reload
#   sudo systemctl enable linkchat-web
#   sudo systemctl start linkchat-web
#   sudo systemctl status linkchat-web
#   sudo journalctl -u linkchat-web -f

[Unit]
Description=LinkChat Web (Next.js Frontend)
Documentation=https://github.com/yourorg/linkchat
After=network.target linkchat-api.service
Wants=linkchat-api.service

[Service]
Type=simple
User=linkchat
Group=linkchat
WorkingDirectory=/opt/linkchat/apps/web

# Next.js production server (after npm run build)
ExecStart=/usr/bin/node node_modules/.bin/next start -p 3000

# Graceful reload
ExecReload=/bin/kill -HUP $MAINPID

# Environment
Environment=NODE_ENV=production
Environment=PORT=3000
EnvironmentFile=/opt/linkchat/apps/web/.env.local

# Restart policy
Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=60s
StartLimitBurst=3

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/linkchat

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=linkchat-web

[Install]
WantedBy=multi-user.target
